POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docker_learning
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=learning_password

# --- Docker Compose only (optional) ---
# Host-side ports Docker publishes to. Leave unset to default to 5432/8000 -
# same as native. Only set these if you want to run the native app (uv run ...)
# and `docker compose up` at the same time, so they don't fight over a port.
# Internal container ports (and container-to-container networking, e.g.
# http://backend:8000) are unaffected either way.
# POSTGRES_HOST_PORT=5433
# BACKEND_HOST_PORT=8001
